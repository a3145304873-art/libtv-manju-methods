   {
    "id": "node-e1f5138c",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 420,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】反拆测试图（六段式·换本角色）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "黑白水墨武侠风，高对比，炭笔线条＋水墨块面混合，古风白发剑客半身像。\n【引用图片说明】{{node-050f0fc0}}＝脸（锁五官与白发）；{{node-994a6484}}＝全身（锁服装与比例）；{{node-79a92516}}＝武器外形。\n\n角色：白发披散、发尾散乱，在身后向左飘，用浓墨块＋飞白细丝表现，方向一致朝左；\n面容清瘦冷峻，五官只用极少线条：眉、眼线、鼻梁、唇线各一笔；脸部大面积纸白、不加阴影细节；\n脸略侧，一只眼落在暗部（半隐）；眼睛细长半垂，不瞪。\n\n服装：白色宽袖长袍，衣纹用排线（hatching）与飞白表现，白袍大面积留白；黑色交领内衬；\n黑色宽腰封，腰封上一枚金属扣件（全图最重的暗部）；黑色护腕；袖口向下有墨色渐染。\n\n武器与握法：右手持一柄长剑，自画面左下向画面深处斜出，**剑身两端都出画**；\n剑身以纸白为主、浅灰渐变为辅，只有一条暗线勾出刃口；剑上的霜纹只用极淡的几笔线表示，\n刃面有少量墨点；**剑不发光、无任何光效**。\n握法：手在剑格的近身一侧，四指绕握剑柄、手背对镜头；手只占画面宽约 8%–10%，\n但**轮廓完整**，以明亮的剑身为背景形成剪影；手腕与前臂成一条直线；剑穗细绳自剑首垂下。\n\n构图：16:9；剑身与画面成约 47 度、跨度超过一条对角线；人物压在右侧三分线、下缘裁到腰；\n画面左上是纸白留白；背景为泼墨块、墨点喷溅与干笔擦痕。\n\n光影：强黑白对比，纸白即高光；头发、腰封、背景墨块压到近黑；\n整体纸白约 12%、近黑约 23%、其余为灰调。\n\n负向：彩色、发光、能量光效、冰晶反光、晶体质感、塑料感、平滑渐变、精细写实、五官细节堆砌、\n剑尖完整留在画面内、手搭在剑上、剑从掌心穿出、折腕、多余手指、多只手、多余手臂、\n正面呆立、居中对称、字幕、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-050f0fc0"
       },
       {
        "node_id": "node-994a6484"
       },
       {
        "node_id": "node-79a92516"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
