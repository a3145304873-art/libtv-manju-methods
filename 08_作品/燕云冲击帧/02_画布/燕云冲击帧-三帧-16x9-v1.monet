     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-aa41ad2c",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读不改】\n人物：年轻男性剑客，白发（长过肩、发尾散乱），白色宽袖长袍＋黑色内衬，黑色腰封与革带，双臂缠绕冰霜气劲；\n面部清瘦、眉压低、眼神冷静；本组统一不戴斗笠。\n武器：藏音·龙跃霄汉——冰晶长剑，剑身半透、内部有龙形霜纹，护手一道极细虹彩（青→品红），\n护手根部结着玉绿色冰晶簇，剑尖处明光偏暖（曜日）。\n配色：墨黑＋纸白＋冰青（主）；玉绿与曜金各占 <5%；全组不用红。\n禁止：红眼、彩色光效、卡通描边、游戏 UI、水印、logo。\n\n——换角色/武器：替换 P1 / P2 两张图，并同步改 K/I/V 九个节点提示词里的人物与武器描述。\n——换画幅：本画布是 16:9 母版；9:16 要重构图（人物与剑尖会出画），不要直接裁。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
      "execution": null,
