     "label": "【待生成】K1 ① 雪落无声 · 立势 1K",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版电影级首帧，只生成一张。\n【引用图片说明】{{node-9e29b1fc}}＝人物（锁脸/白发/白袍黑带/冰霜气劲）；{{node-73841978}}＝武器（锁冰晶剑外形/龙形霜纹/护手虹彩）。\n【画面】全身立势：人物立于雪原，身体略侧对镜头，右手垂剑、剑尖指向左下地面；无招式、无动作，\n只有白发与衣摆被右后方来风吹动；脚下有一圈被风刮出的雪纹。\n【构图/机位】16:9 横版，平视略低；人物站右三分线，脚在画面下缘 0.86 处；左侧三分之一是空白雪地，\n立四五根旧木桩；剑尖落点对齐左下三分线；主斜线从剑尖到左上留白约 30°。\n【光影/材质】逆光，天光压在人物背后，人整体压成暗块；只有白发边缘、肩线、剑刃吃一道冷白边光；\n剑尖一点暖金。背景深度虚化，雪粒可见。\n负向：红、彩色光效、发光眼、多手多剑、弯腰、下蹲、弓步、人物过小、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-9e29b1fc"
       },
       {
        "node_id": "node-73841978"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
