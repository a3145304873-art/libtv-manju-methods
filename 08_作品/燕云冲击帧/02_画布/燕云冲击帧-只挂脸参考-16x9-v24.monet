   {
    "id": "node-740497e0",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 1620,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】K1 ① 起势 · 剑收右腰（侧身）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版电影级首帧，只生成一张。\n【引用图片说明】{{node-03aabffc}}＝脸（只锁五官与白发，**不参考它的姿势**）。\n【机位】**平视**，半身（腰以上），镜头与人物胸口同高。\n【姿势】**侧身 3/4、面朝画左**；右手持剑收在**右腰侧、剑身在身后**、剑尖朝后下方（画面里看不见剑尖）；\n左臂自然垂在身侧；重心**压后腿**、膝微屈；肩背绷着、下颌收。\n【握法】右手正握剑柄：虎口朝剑格、食指扣在剑格下沿、其余三指环握、掌心贴柄；剑格在拳前约两指、剑身自拳背上方伸出；手腕与前臂成一条直线、不许折腕。左手并起食指中指成剑指。\n【光影】侧逆光、冷调、实色；暗部近黑；剑身**不发光、不要冰晶特效**，只留一道冷白高光，保证剑的朝向看得清。\n负向：正脸对镜头、剑在身前、剑横在腹前、剑挡胸、发光、冰晶光效、全身、平视正面、彩色、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-03aabffc"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
    "specialParams": null,
