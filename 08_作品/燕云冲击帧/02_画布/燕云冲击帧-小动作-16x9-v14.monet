   {
    "id": "node-476d6654",
    "type": "input-text",
    "mainOutputId": "output-476d6654",
    "meta": {
     "x": 20,
     "y": 470,
     "width": 320,
     "height": 470,
     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-476d6654",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读】\n人物：年轻男性剑客，白发（过胸、发尾散乱），白袍＋黑内衬，黑腰封、黑护腕，深色靴；双臂淡薄冰霜气劲；\n面部清瘦、眉压低、眼神冷静；不戴斗笠。\n武器：藏音·龙跃霄汉——冰晶长剑，剑身半透、龙形霜纹，护手一道细虹彩，护手根部玉绿晶簇，剑尖暖光。\n\n【本画布的铁律】\n1. 全部近景或半身，**不许出现全身**；\n2. 动作是关节级：剑尖或剑身移动约画面 1/8–1/4，身体只有一个关节在动；\n3. 构图按参考：主体被画框裁掉、剑尖出画、只留一块白、视线与刃线同向出画。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
      "execution": null,
      "graphRunId": null,
