     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版水墨·**红黑**冲击帧插画，只生成一张。\n【引用图片说明】{{node-4a12a002}}＝姿势与构图依据（不许改）；{{node-d5cf32ff}}＝人物特征；{{node-fd88f884}}＝武器。\n【任务】把 {{node-4a12a002}} 改画成水墨红黑冲击帧。\n【构图·爆点】爆点＝**剑尖（画面右上）**：从剑尖向上炸开猩红墨爆；一道**斜向墨痕**从左下贯到右上充当速度线；\n下部留白多一点，让\"往上拔\"的势读得出来。\n【构图规则】主体被裁（裁到胸、头顶贴上缘）；只留一块白在左下约四分之一。\n【气韵】生宣纸筋可见；破墨涨墨、飞白擦出；墨点悬空、衣带未落。\n【色彩】纸白＋焦墨＋猩红，红只在剑尖上方（约 14%）。\n【光影】一道硬侧光，暗部近黑，亮部过曝成纸白。\n负向：全身、见腿、剑尖留在画面内、多处留白、居中对称、塑料感、渐变、矢量感、精致插画、3D、文字、水印、logo、游戏UI。\n",
      "reference_images": [
       {
        "node_id": "node-4a12a002"
       },
       {
        "node_id": "node-d5cf32ff"
       },
       {
        "node_id": "node-fd88f884"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
