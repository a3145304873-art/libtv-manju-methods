   {
    "id": "node-799d79b4",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】I1 ① 冲击帧 · 向心放射",
