   {
    "id": "node-e366d246",
    "type": "input-text",
    "mainOutputId": "output-e366d246",
    "meta": {
     "x": 20,
     "y": 470,
     "width": 320,
     "height": 420,
     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-e366d246",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读】\n人物：年轻男性剑客，白发（长过胸、发尾散乱），白色宽袖长袍＋黑色内衬，黑色腰封与革带，\n手腕黑色护腕，双脚深色靴；双臂缠绕淡薄的冰霜气劲（薄，不要抢主体）；面部清瘦、眉压低、眼神冷静；\n本组不戴斗笠。\n\n武器：藏音·龙跃霄汉——冰晶长剑；剑身半透、内部有龙形霜纹；护手一道极细虹彩（青→品红）；\n护手根部结着玉绿色冰晶簇；剑柄缠绳；剑尖明光偏暖（曜日）。\n\n【这张画布只做资产】把两个原始截图里的信息\"洗\"成干净资产：脸 / 正面全身 / 侧面 / 背面 / 武器 / 手。\n资产的用途是给下游生成当参考图，不是最终画面——所以要求：正视、全身、纯色底、无遮挡、无 UI、无水印。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
      "execution": null,
      "graphRunId": null,
      "iterationPath": null,
      "taskSource": null,
      "taskId": null,
