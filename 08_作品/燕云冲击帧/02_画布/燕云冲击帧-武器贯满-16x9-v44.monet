   {
    "id": "node-e43d5c58",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 1620,
     "y": 340,
     "width": 320,
     "height": 280,
     "label": "【待生成·重出】② K2 两道平行光刃",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版，**纯黑背景上的两道剑光**，只生成一张。\n【构图·按参考实测】两道刃**只占画面左侧**：从画面宽度的 9% 到 39%（左侧三分之一强）；\n**画面右侧三分之二（40%–100%）必须是纯黑，什么都不许有**——这一条比光刃本身更重要。\n【形状】每道向右倾约七十八度、从上缘贯到下缘；每道宽约画面宽度的百分之一半；两道间距约画面宽度百分之十二。\n【质感】内部是细密星尘颗粒（不是实心白）；边缘有毛刺状横向拉丝与柔和辉光；左刃稍暗、右刃更亮。\n【附加】两刃之间、画面高度约 45% 处，一条极细的横向白线（约两像素）。\n【限制】整幅只有光与黑；**不要画实体剑**（没有剑格、护手、剑柄）、不要场景、不要人。\n负向：右侧有亮部、光刃居中、只有一道光、光柱、横向光带、实体剑、剑格、护手、剑柄、人物、手、场景、背景实体、彩色、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-9cba270c"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
