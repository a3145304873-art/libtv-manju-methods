     "width": 320,
     "height": 280,
     "label": "【待生成】I1 ① 冲击帧 · 向心放射",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版水墨·**红黑**冲击帧插画，只生成一张。\n【引用图片说明】{{node-18d8f5f5}}＝姿势与构图的唯一依据（刺到最远、近景、剑的透视角度不许改）；{{node-89322dcf}}＝人物特征（眼型与白发走向）；{{node-90ffa62a}}＝武器外形。\n【任务】把 {{node-18d8f5f5}} 这一帧**改画成水墨红黑冲击帧**：宣纸上的大写意，不是写实转绘。\n【构图·爆点】爆点＝**剑尖（画面中心偏左、贴近镜头）**：墨从剑尖向四周**向心放射**，像一道浪朝镜头扑来；\n剑身近大远小、透视缩短；人物半张脸在焦墨里，眼里一点纸白神光；衣摆与发丝向后拉成飞白。\n【色彩】宣纸白底＋焦墨＋猩红，红只在剑尖前一小片（约 12%）；无其他彩色。\n【质感】浓墨泼洒、破笔、飞白、溅点；纸纹纤维可见；无一笔平滑渐变。\n【限制】严格平面（纸上绘画感）；极简：剑一笔、人两笔、眼一点。\n负向：赛璐璐、放射几何线、写实、照片、3D渲染、体积光、景深、胶片颗粒、青绿金紫、柔和渐变、碎纹理、多人物、文字、水印、logo、游戏UI。\n",
      "reference_images": [
       {
        "node_id": "node-18d8f5f5"
       },
       {
        "node_id": "node-89322dcf"
       },
       {
        "node_id": "node-90ffa62a"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
