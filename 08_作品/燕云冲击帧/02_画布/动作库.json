      "动作": [
        {
          "名": "起手式（道之极式）",
          "发力点": "剑尖",
          "K": "侧身3/4、剑自然垂在右侧、左手剑指垂腿旁、眼半敛",
          "E": "抬眼+腕提30°、剑仍垂体侧、身体别处不动",
          "I": "墨从剑尖向上炸开、人物中景、脸在暗部只露一眼"
        },
        {
          "名": "拔剑式（拔剑式）",
          "发力点": "剑身",
          "K": "右手绕到左腰后按剑柄、剑被身体挡住",
          "E": "剑自腰后抽出、斜向右上、剑尖朝右上、身体转正",
          "I": "一道斜贯画面的剑光（右下→左上）+墨点飞白"
        },
        {
          "名": "万剑式（剑之极）",
          "发力点": "剑身／剑气",
          "K": "剑斜垂身前、剑尖朝左下、重心下沉",
          "E": "剑向右上挥到位、臂伸展、身体转正、不许画剑气",
          "I": "巨大墨刃自剑身向右上横贯画面上三分之一、人物压到右下角占1/3高"
        }
      ],
      "握法": {
        "正握": "手握剑柄，拇指屈压于食指第二指节；剑与臂成一条直线",
        "钳把": "虎口靠近剑格，食指与拇指加虎口夹持剑柄，其余三指自然附柄",
        "压把": "拇指与食指掐握剑柄，虎口贴剑格之上，无名指与小指压柄后端（防剑尖下垂）",
        "比例": "剑柄含剑首约占全剑 1/5；手宽约为柄长 1/3；护手宽约为柄长 2 倍",
        "发力链": "腰 → 肩 → 臂 → 腕 → 剑尖",
        "常见错法": [
          "无剑柄",
          "握在刃根",
          "剑从掌心穿出",
          "折腕",
          "该用压把时剑尖下垂"
        ]
      }
    },
    "刀": {
      "动作": [
        {
          "名": "劈",
          "发力点": "刀锋前段",
          "K": "双手举刀过顶右后、后倾",
          "E": "刀沿中线劈落、刃口朝下、上身前倾15°",
          "I": "刀锋压向画面下缘、垂直墨瀑"
        },
        {
          "名": "撩",
          "发力点": "刀锋前段",
          "K": "刀垂右下、肩沉",
          "E": "刀自下向上撩至肩高、刃口朝上",
          "I": "刀身斜向上、墨浪向上"
        },
        {
          "名": "抹",
          "发力点": "刀刃",
          "K": "刀横在胸前、刃朝外",
          "E": "刀沿水平贴画横拖",
          "I": "刀刃贴画面横切、横向墨痕"
        }
      ],
      "握法": {
        "单手持柄": "刃口朝外、刀背朝上，虎口贴护手；缠头时手腕内旋",
        "比例": "刀柄约占全刀 1/6",
        "发力链": "腰胯拧转 → 肩 → 臂 → 腕，刀刃走弧",
        "常见错法": [
          "刃口朝内",
          "刀背当刃用",
          "双手握单手刀",
          "把刀画成双刃剑"
        ]
      }
    },
    "枪": {
      "动作": [
        {
          "名": "扎",
          "发力点": "枪尖",
          "K": "枪收腰侧、枪尖朝前",
          "E": "枪直线送出、枪尖指镜头",
          "I": "枪尖指观者、枪身缩短透视"
        },
        {
          "名": "崩",
          "发力点": "枪身前段",
          "K": "枪横身前",
          "E": "枪身上崩、枪尖上扬",
          "I": "枪身斜向上扫、墨浪上翻"
        },
        {
          "名": "拦",
          "发力点": "枪杆",
          "K": "枪横胸前",
          "E": "枪杆竖挡在身前",
          "I": "枪杆竖切前景、竖向墨痕"
        }
      ],
      "握法": {
        "持枪": "枪根抵在掌心、握住把端（似握螺丝刀）；前手管方向、后手催力",
        "比例": "握把端占枪长约 1/4，两手不并拢",
        "发力链": "后手催 → 拧腰 → 送胯 → 力透枪尖",
        "常见错法": [
