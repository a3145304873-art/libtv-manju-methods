          "双手过近",
          "枪身弯曲",
          "枪尖软塌"
        ]
      }
    },
    "拳掌": {
      "握法": {
        "冲拳": "拳面朝前、肘不锁死",
        "推掌": "掌根发力",
        "常见错法": [
          "直臂锁死",
          "掌心朝自己"
        ]
      }
    },
    "弓": {
      "握法": {
