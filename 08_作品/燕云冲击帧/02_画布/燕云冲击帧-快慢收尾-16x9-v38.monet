   {
    "id": "node-dcd70232",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】① 4s 一镜：特写→后拉→白闪→墨凝",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-21d34da8}}：暗底脸特写、只露一只眼。\n【尾帧锁定】最后一帧停在 {{node-51b6e3cb}}：水墨成画、剑与脊柱成三十五度斜线的姿势。\n【节奏·蓄爆收】蓄 0–1.2 秒（镜头轻推、右臂抬起一半，幅度小）→ 爆 1.2–1.6 秒（**0.4 秒内完成**）→ 收 1.6–4.0 秒（收尾动作一次做完，之后只余飘动）。\n0.0–1.2 秒 蓄：镜头极轻地后拉一点；右臂抬到一半、手指收紧；眼神从半敛到锁定；雪粒横飞。\n1.2–1.6 秒 爆：**白闪 + 墨从剑尖炸开**，都在 0.4 秒内完成八成——快到只剩一片残影，不许拉到两秒。\n1.6–2.6 秒 收尾动作（关键）：墨里的人形**手腕一翻、剑自右上向左下划一道弧**，落在尾帧那条三十五度斜线上；衣摆被这一下带得向右甩。\n2.6–4.0 秒 收势已定：墨还在洇、雪还在落、衣摆余势未消——**人物不再动**，只有墨与雪在动。\n【禁止】切镜、彩色、发光特效铺满、慢动作、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
      "reference_images": [
       {
        "node_id": "node-51b6e3cb"
       }
      ],
      "reference_videos": [],
      "reference_audios": [],
      "first_frame_image": {
       "node_id": "node-21d34da8"
      },
      "last_frame_image": {
       "node_id": "node-51b6e3cb"
      },
      "aspect_ratio": "16:9",
      "resolution": "720p",
      "duration": 4,
      "generate_audio": true,
      "seed": -1
     }
    },
    "specialParams": null,
    "config": null,
