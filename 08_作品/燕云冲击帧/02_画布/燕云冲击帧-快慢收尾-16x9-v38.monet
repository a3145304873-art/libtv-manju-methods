   {
    "id": "node-6a18033e",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 3220,
     "y": 660,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】③R 全能参考：实拍→水墨化 4s",
