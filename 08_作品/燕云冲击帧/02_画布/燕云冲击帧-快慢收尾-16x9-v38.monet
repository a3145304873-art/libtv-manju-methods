   {
    "id": "node-9acb85fa",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 340,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】② 4s 一镜：光点→星芒→刺退→眼",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-8486aa9c}}：纯黑底两道平行光刃，中上方一个小光点。\n【尾帧锁定】最后一帧停在 {{node-31509c03}}：黑白水墨的眼睛特写。\n【节奏·蓄爆收】蓄 0–1.0 秒（光刃微涨、星尘漂）→ 爆 1.0–1.4 秒（**0.4 秒内**）→ 收 1.4–4.0 秒（光刺收尽 + 收尾眼神）。\n0.0–1.0 秒 蓄：两道光刃轻轻外涨、内部星尘漂动；中间那个光点迅速变亮变大。\n1.0–1.4 秒 爆：**光点炸成星芒**，光刺以不同速度向外刺出——0.4 秒内完成，快到像一次闪烁。\n1.4–2.6 秒 收：光刺**逐根回缩**（一根接一根，不是一次性消失）；星芒中心露出一只眼睛，眼皮从闭到睁。\n2.6–4.0 秒 收尾眼神（关键）：**瞳孔猛地收缩一下、眼神一沉**，睫毛微颤——这是\"收势\"的那一眼；之后只是星尘在飘。\n【禁止】切镜、淡入淡出、变彩色、慢动作、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
