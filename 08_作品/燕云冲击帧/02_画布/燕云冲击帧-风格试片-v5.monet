   {
    "id": "node-ae31be81",
    "type": "input-text",
    "mainOutputId": "output-ae31be81",
    "meta": {
     "x": 20,
     "y": 470,
     "width": 320,
     "height": 420,
     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-ae31be81",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读】\n人物：年轻男性剑客，白发（长过肩、发尾散乱），白色宽袖长袍＋黑色内衬，黑色腰封与革带，双臂缠绕冰霜气劲；\n面部清瘦、眉压低、眼神冷静；本组不戴斗笠。\n武器：藏音·龙跃霄汉——冰晶长剑，剑身半透、内部有龙形霜纹，护手一道极细虹彩（青→品红），\n护手根部结着玉绿色冰晶簇，剑尖明光偏暖（曜日）。\n\n【本画布只做一件事】同一张定格帧 T1，跑五种冲击帧风格，选一个再铺另外两镜。\n五种风格只改 I，K/V 不动（写实、无红）。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
