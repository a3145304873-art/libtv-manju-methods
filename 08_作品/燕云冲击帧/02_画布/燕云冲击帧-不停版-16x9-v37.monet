   {
    "id": "node-b0419738",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】① 4s 一镜：特写→后拉→白闪→墨凝",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-1a522e21}}：暗底脸特写、只露一只眼。\n【尾帧锁定】最后一帧停在 {{node-6c46917b}}：水墨成画、剑与脊柱成斜线的帅气姿势。\n【总则·每一段都在推进】这 4 秒像水流，一刻不停：镜头一直在缓慢移动（推、拉、摇任选其一）；人物的呼吸、头发、衣摆、剑身反光、雪粒、墨与光，至少三样同时在动；每一段都要出现新的位移或新的形态，节奏是连续推进，而不是「跳一下再收住」。\n【动作清单】\n0.0–1.2 秒 镜头**持续后拉**（不许停）：从脸拉到半身；同时右臂缓慢抬起、手指从张开收拢成握剑；头发与衣角持续向后飘。\n1.2–2.0 秒 镜头继续后拉至中景：人物手腕翻转，剑身从身前划到体侧；雪粒持续横向飞过画面。\n2.0–2.4 秒 白闪（纸白、不是纯白），从画面中心向外涨，约两帧完成。\n2.4–3.6 秒 墨从剑尖向四周**持续翻涌**（十二帧内完成八成，但边缘一直在动）；墨里的人形逐渐凝实；镜头仍在缓慢后拉。\n3.6–4.0 秒 到水墨成画那一瞬：**墨还在洇、雪还在落、衣摆还在飘**，每一帧都还在变。\n【禁止】切镜、彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
      "reference_images": [
       {
        "node_id": "node-6c46917b"
       }
      ],
      "reference_videos": [],
      "reference_audios": [],
      "first_frame_image": {
       "node_id": "node-1a522e21"
      },
      "last_frame_image": {
       "node_id": "node-6c46917b"
      },
      "aspect_ratio": "16:9",
      "resolution": "720p",
      "duration": 4,
      "generate_audio": true,
      "seed": -1
     }
    },
    "specialParams": null,
    "config": null,
