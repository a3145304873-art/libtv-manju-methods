   {
    "id": "node-8262eb29",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 3220,
     "y": 980,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】④R 全能参考：旧装→新装 4s",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【全能参考】参考图依次是：{{node-d958a278}}＝旧装起手；{{node-c1ab3972}}＝整屏墨浪；{{node-505a045e}}＝服装比例。新装按文字描述生成：银纹白袍＋黑金披风＋束发。\n【任务】4 秒：**同一个人**从旧装变新装，中间用墨浪遮住：\n0.0–1.4 秒 旧装（素白袍），右手自腰后抽剑半尺、剑身现一线冷光；\n1.4–2.0 秒 墨浪涨满画面（墨占九成、边缘飞白）；\n2.0–3.4 秒 墨从中间向两侧退开，**新装已经出现**（银纹白袍＋黑金披风），剑向前递出；\n3.4–4.0 秒 剑递到最远，披风与发丝持续扬起、墨滴与雪粒一直在落。\n【禁止】负向：切镜、变彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
