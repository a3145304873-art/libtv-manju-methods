   },
   {
    "id": "node-0c8fbacd",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 340,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】② 4s 一镜：光点→星芒→刺退→眼",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-e71ff1f2}}：纯黑底两道平行光刃，中上方一个小光点。\n【尾帧锁定】最后一帧停在 {{node-5fa25649}}：黑白水墨的眼睛特写。\n【总则·每一段都在推进】这 4 秒像水流，一刻不停：镜头一直在缓慢移动（推、拉、摇任选其一）；人物的呼吸、头发、衣摆、剑身反光、雪粒、墨与光，至少三样同时在动；每一段都要出现新的位移或新的形态，节奏是连续推进，而不是「跳一下再收住」。\n【动作清单】\n0.0–1.0 秒 两道光刃**持续向外涨**、内部星尘持续漂动；中间那个小光点迅速变亮变大。\n1.0–2.0 秒 光点炸成星芒：光刺**以不同速度向外伸长**（有的快有的慢、形成层次），星芒中心出现一只眼睛（眼皮先闭着）。\n2.0–3.2 秒 光刺**逐根退散**（不是一次性收掉）；眼睛从闭到睁，瞳孔逐渐清晰。\n3.2–4.0 秒 光刺继续退、眼睛持续睁开到最大，睫毛与瞳孔细节逐渐显出；星尘仍在飘。\n【禁止】切镜、淡入淡出、变彩色、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
