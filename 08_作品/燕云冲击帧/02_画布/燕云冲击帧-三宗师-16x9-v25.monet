   {
    "id": "node-5fcb5386",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 1620,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】K1 ① 起手式 · 垂剑（近景）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版电影级首帧，只生成一张。\n【引用图片说明】{{node-c3394681}}＝脸（只锁五官与白发，不参考姿势）。\n【机位】平视，近景（胸以上）。\n【姿势】**起手式**：侧身 3/4、面朝画左；右手持剑**自然垂在身体右侧**、剑尖朝下、刃口朝前后；左手并指成剑指、垂在左腿旁；重心平均落在两腿；眼神半敛、下颌微收。\n【握法】右手正握剑柄：虎口朝剑格、食指扣在剑格下沿、其余三指环握、掌心贴柄；剑格在拳前约两指、剑身自拳背上方伸出；手腕与前臂成一条直线、不许折腕。左手并起食指中指成剑指。\n【光影】侧逆光、冷调、实色；暗部近黑；剑身**不发光、不要冰晶特效**，只留一道冷白高光，保证剑的朝向看得清。\n负向：正脸对镜头、剑横在腹前、剑在身后、手臂抬到胸前、发光、冰晶光效、全身、彩色、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-c3394681"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
    "specialParams": null,
