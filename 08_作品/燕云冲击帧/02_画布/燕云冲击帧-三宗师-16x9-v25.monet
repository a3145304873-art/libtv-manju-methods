   {
    "id": "node-fd099a57",
    "type": "input-text",
    "mainOutputId": "output-fd099a57",
    "meta": {
     "x": 20,
     "y": 470,
     "width": 320,
     "height": 470,
     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-fd099a57",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读】\n人物：年轻男性剑客，白发（过胸、发尾散乱），白袍＋黑内衬，黑腰封、黑护腕，深色靴；双臂淡薄冰霜气劲；\n面部清瘦、眉压低、眼神冷静；不戴斗笠。\n武器：藏音·龙跃霄汉——冰晶长剑，剑身半透、龙形霜纹，护手一道细虹彩，护手根部玉绿晶簇。\n\n【本画布的铁律】\n1. 画幅小：全部近景或半身，不许出现全身；\n2. 动作小但**发力满**：腰胯先动、剑后到；重心在两腿之间明显转移；脚下雪面被蹬开；衣摆头发被带起；\n3. **0.4–0.5 秒内打完**，其余时间保持——快，才有力气；\n4. 构图：主体被裁、兵器出画、只留一块白、视线与刃线同向出画。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
      "execution": null,
      "graphRunId": null,
      "iterationPath": null,
