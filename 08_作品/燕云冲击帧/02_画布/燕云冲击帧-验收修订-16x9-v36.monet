   {
    "id": "node-15ea7583",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 980,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】④ 4s 一镜：按剑→抽剑→墨浪→新装",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-d6e1b959}}：夜雪城楼、素白袍、右手按剑柄，机位固定。\n【尾帧锁定】最后一帧必须停在 {{node-54d79d2d}}（水墨新装帧）上。\n【任务】4 秒连续一镜：\n0.0–1.4 秒 右手把剑自腰后**抽出半尺**、剑身现出一线冷光，几粒墨点从剑身浮起；\n1.4–2.0 秒 墨点连成**墨刃**并涨满画面（墨占九成，边缘飞白）；\n2.0–3.4 秒 墨从中间向两侧退开，**新装已经出现**（银纹白袍＋黑金披风），剑向前递出；\n3.4–4.0 秒 定格，墨滴与雪粒落下。\n【禁止】负向：切镜、变彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
      "reference_images": [
       {
        "node_id": "node-54d79d2d"
       }
      ],
      "reference_videos": [],
      "reference_audios": [],
      "first_frame_image": {
       "node_id": "node-d6e1b959"
      },
      "last_frame_image": {
       "node_id": "node-54d79d2d"
      },
      "aspect_ratio": "16:9",
      "resolution": "720p",
      "duration": 4,
      "generate_audio": true,
      "seed": -1
     }
    },
    "specialParams": null,
    "config": null,
    "createdAt": "2026-11-02T12:20:00.000+08:00",
