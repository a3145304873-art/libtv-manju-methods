   {
    "id": "node-171345f6",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 2420,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】① I1 水墨定格尾帧（帅气）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版，**黑白水墨冲击帧**，只生成一张。\n【引用图片说明】{{node-cff319d2}}＝姿势依据；{{node-53b305b2}}＝脸；{{node-e3914bf6}}＝服装；{{node-c1061ffa}}＝武器外形。\n【构图先说】**近景，人物占画面高度约七成八**；留白只留边缘一成五；**镜头略低于胸口、微仰拍**。\n【线条】关键：**剑身与脊柱连成一条约三十五度的直线**——不是\"人歪着、剑也歪着\"，而是两者同向、合成一条硬斜线；\n右肩比左肩高约一掌；重心落在左腿，右腿放松（**绝不下蹲、不马步**）。\n【剑位】**剑尖留在画面里**、指向画左下方、距人物约一臂；不许把剑尖画到画外。\n【衣摆】白发与披风**全部朝画右后方**被带起，方向一致。\n【墨】墨只在两处：剑尖外一小片飞墨、脚下地面一圈浓墨；其余留白。\n【光】强黑白对比，暗部纯黑无灰雾；只露一只眼，脸不刻五官。\n负向：人物过小、大留白、剑尖出画、下蹲、弓步、马步、正面站立、对称、居中、彩色、实体背景、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-cff319d2"
       },
       {
        "node_id": "node-53b305b2"
       },
       {
        "node_id": "node-e3914bf6"
       },
       {
        "node_id": "node-c1061ffa"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
    "specialParams": null,
    "config": null,
    "createdAt": "2026-10-30T12:10:00.000+08:00",
