   {
    "id": "node-72878ad8",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 1620,
     "y": 340,
     "width": 320,
     "height": 280,
     "label": "【待生成·重出】② K2 两道平行光刃",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版，**纯黑背景上的两道剑光**，只生成一张。\n【第一句就是硬要求】**画面里是两道、不是一道**：两道平行、互不相交的细长光刃，从画面上缘贯到下缘。\n【形状】每道向右倾约七十八度；每道宽约画面宽度的百分之一半（细，不是光柱）；两道之间约隔画面宽度的百分之十二。\n【质感】光刃内部不是实心白，是细密的星尘颗粒；边缘有毛刺状横向拉丝与柔和辉光；左刃稍暗、右刃更亮。\n【附加】画面正中间还有一条极细的横向白线（约两像素），横贯两刃之间。\n【限制】整幅只有光与黑；**不要画实体剑**（没有剑格、护手、剑柄）、不要场景、不要人。\n负向：只有一道光、光柱、横向光带、实体剑、剑格、护手、剑柄、人物、手、场景、背景实体、彩色、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-c1061ffa"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
    "specialParams": null,
    "config": null,
    "createdAt": "2026-10-30T12:10:00.000+08:00",
