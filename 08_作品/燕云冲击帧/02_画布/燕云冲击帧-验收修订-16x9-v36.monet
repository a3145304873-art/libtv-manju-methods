   {
    "id": "node-31e4d03e",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 3220,
     "y": 660,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】③R 全能参考：实拍→水墨化 4s",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【全能参考】参考图依次是：{{node-7a6f8c7e}}＝同一姿势的**实拍**；{{node-2f89f34a}}＝同一姿势的**水墨版**；{{node-e3914bf6}}＝服装比例。\n【任务】4 秒：**保持参考图里的姿势与机位完全不变**，只把画面从\"实拍\"变成\"水墨\"：\n0.0–1.4 秒 实拍状态，雪粒落下；\n1.4–1.8 秒 一道冷光自左向右扫过画面；\n1.8–3.0 秒 实色逐层退去、墨线从轮廓浮现（**水墨化**，不是淡入、不是叠化）；\n3.0–4.0 秒 完全变成黑白水墨定格，只有墨滴落下。\n【禁止】负向：切镜、变彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
