    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 1300,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】④B 墨浪退去+剑递出 4s",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-4e78d951}}：水墨雪原、新装、剑斜指画外。\n【任务】0–1.2 秒墨浪从右向左退去（黑墨从画面右缘缩走）；1.2–2.4 秒剑向前递到位；2.4 秒起定格，只有墨滴与雪粒落下。\n【禁止】负向：镜头运动、推拉摇移、切镜、变水墨、黑白化、彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
      "reference_images": [],
