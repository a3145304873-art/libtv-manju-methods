{
  "版本": 1,
  "说明": "高光帧设计模板库。区别不在画风，在「信息释放顺序」。每条给逐拍表、时间预算、静止占比、冲击元件、适用条件。",
  "通用": {
    "时长范围": "3.9–6.0s（2.0-mini 单条上限内）",
    "爆点亮度": "白闪用 180–200，不用 255（纯白会廉价）",
    "静止占比": "≥60%（短版 ≥85%）",
    "切点数": "1 个（位置在「器/景 → 人」）",
    "字": "四字内，压留白或黑场"
  },
  "模板": {
    "A-凝视型": {
      "参考": "道之极 3.93s/118帧",
      "顺序": [
        "脸",
        "眼",
        "墨凝"
      ],
      "时长": 3.93,
      "静止占比": 0.92,
      "硬切": 1,
      "爆点帧数": 12,
      "拍": [
        {
          "起": 0.0,
          "止": 0.83,
          "画面": "黑场→脸浮出",
          "手法": "三段提亮 23→39→54"
        },
        {
          "起": 0.83,
          "止": 1.7,
          "画面": "脸部特写，红眼亮起",
          "手法": "只加眼部发光，不重画"
        },
        {
          "起": 1.7,
          "止": 2.27,
          "画面": "硬切中景，抬手，亮度下压",
          "手法": "54→46 吸气"
        },
        {
          "起": 2.27,
          "止": 2.63,
          "画面": "白闪 1 帧 → 墨凝 12 帧",
          "手法": "白闪 188；结构差 0.84→0.32"
        },
        {
          "起": 2.63,
          "止": 3.93,
          "画面": "水墨定格 + 渐暗",
          "手法": "60→33→27"
        }
      ],
      "K": "脸特写（占满画面、只给一只眼）",
      "E": "中景抬手",
      "I": "墨凝（从中心涌出凝成人形）",
      "适用": "人物辨识度高、有眼神戏；兵器不重要",
      "prompt要点": [
        "脸占满画面",
        "只给一只眼、不刻画五官",
        "墨从画面中心涌出、凝成人形"
      ]
    },
    "B-器物型": {
      "参考": "剑之极 6.00s/180帧",
      "顺序": [
        "竖剑（无人）",
        "星芒",
        "眼睛特写"
      ],
      "时长": 6.0,
      "静止占比": 0.35,
      "硬切": 1,
      "爆点帧数": 1,
      "拍": [
        {
          "起": 0.0,
          "止": 1.5,
          "画面": "全黑，只左下角一小条剑光",
          "手法": "亮度 1.3；字幕先上"
        },
        {
          "起": 1.53,
          "止": 2.33,
          "画面": "左右各一把竖立光刃，中间纯黑，一道斜光在移",
          "手法": "亮度 8；人不出现"
        },
        {
          "起": 2.33,
          "止": 2.4,
          "画面": "中上方一点炸成星芒，**中心已是一只眼睛**",
          "手法": "光刺向外张开"
        },
        {
          "起": 2.4,
          "止": 2.63,
          "画面": "光刺退散变稀，眼睛越来越清楚（位置大小不变）",
          "手法": "连续过渡，非切"
        },
        {
          "起": 2.63,
          "止": 5.23,
          "画面": "眼睛特写，脸从暗部浮现，之后完全静止",
          "手法": "结构差 0.16–0.19"
        },
        {
          "起": 5.27,
          "止": 6.0,
          "画面": "淡出到黑",
          "手法": "不闭合"
        }
      ],
      "K": "黑底双竖剑（无人）",
      "E": "眼睛特写（剑身作左缘）",
      "I": "同上，水墨/黑白皆可",
      "适用": "兵器好看且能立起来（剑/刀/枪/巨剑）",
      "prompt要点": [
        "黑底",
        "只露刃口一道反光",
        "画面里没有人是允许的",
        "星芒极小、纯白"
      ],
      "转场": "星芒收束成眼（连续过渡，不是硬切）：光点→星芒(中心是眼)→光刺退散→眼睛特写",
      "难点": "星芒中心必须从一开始就有眼睛，且位置/大小全程不跳；做了硬切就不流畅了"
    },
    "C-光效型": {
      "参考": "水墨巨剑 6.00s/180帧",
      "顺序": [
        "暗/墨点",
        "巨剑成形",
        "定格"
      ],
      "时长": 6.0,
      "静止占比": 0.5,
      "硬切": 0,
      "爆点帧数": 0,
      "拍": [
        {
          "起": 0.0,
          "止": 2.5,
          "画面": "暗底、墨点飞溅、巨剑逐渐成形",
          "手法": "帧差最高 77"
        },
        {
          "起": 2.5,
          "止": 3.0,
          "画面": "亮度抬升 79→120",
          "手法": "曝露"
        },
        {
          "起": 3.0,
          "止": 5.0,
          "画面": "水墨完成稿定格（斗笠+巨剑斜指+墨点）",
          "手法": "结构差 0.2"
        },
        {
          "起": 5.0,
          "止": 6.0,
          "画面": "渐暗",
          "手法": "—"
        }
      ],
      "K": "暗底墨点",
      "E": "水墨完成稿",
      "I": "完成稿（巨剑斜指画外）",
      "适用": "兵器巨大、有成型过程；适合长镜头",
      "prompt要点": [
        "墨点飞溅",
        "剑身斜指画外",
        "一次成型的水墨插画"
      ]
    },
    "D-景观型": {
      "参考": "云海天光 6.00s/180帧",
      "顺序": [
        "云海",
        "光柱",
        "山巅小人"
      ],
      "时长": 6.0,
      "静止占比": 0.95,
      "硬切": 0,
      "爆点帧数": 0,
      "拍": [
        {
          "起": 0.0,
          "止": 6.0,
          "画面": "云海+山巅小人+光柱",
          "手法": "全程帧差 0.2–4.7，极缓"
        }
      ],
      "K": "景（人物占 1/20）",
      "E": "同景微推",
      "I": "不需要",
      "适用": "要格局/片头定场，不适合当冲击帧",
      "prompt要点": [
        "人物极小",
        "光柱是主体",
        "云海有层次"
      ]
    },
    "E-循环型": {
      "参考": "拔剑 29.4s = 5.3s×5.5",
      "顺序": [
        "水墨定格",
        "彩色实拍",
        "回水墨"
      ],
      "时长": 5.3,
      "静止占比": 0.6,
      "硬切": 2,
      "爆点帧数": 0,
      "拍": [
        {
          "起": 0.0,
          "止": 3.2,
          "画面": "水墨定格",
          "手法": "2.9s 内结构差 <0.02"
        },
        {
          "起": 3.2,
          "止": 5.3,
          "画面": "彩色实拍",
          "手法": "切点 1 帧偏亮 101"
        }
      ],
      "K": "水墨定格",
      "E": "实拍",
      "I": "水墨",
      "适用": "刷停留/完播的账号向内容",
      "prompt要点": [
        "单条信息量只需 3 秒",
        "两条素材互切"
      ]
    },
    "F-变装型": {
      "参考": "用户给的变装 prompt（深度动捕 + 紫花瓣光刃转场，9s 两段）",
      "顺序": [
        "旧场景+旧装",
        "元素三态→填满画面",
        "新场景+新装"
      ],
      "时长": 9.0,
      "静止占比": 0.35,
      "硬切": 0,
      "爆点帧数": 12,
      "转场": "元素填满画面（遮罩），不是硬切",
      "元素三态": "墨点 → 墨刃 → 墨滴散落（同一种元素贯穿三态才丝滑）",
      "拍": [
        {
          "起": 0.0,
          "止": 1.8,
          "段": "A",
          "画面": "夜雪城楼、素白袍、侧身按剑柄",
          "动作": "蓄"
        },
        {
          "起": 1.8,
          "止": 3.6,
          "段": "A",
          "画面": "抽剑半尺、剑身一线冷光、几粒墨点浮起",
          "动作": "抽剑"
        },
        {
          "起": 3.6,
          "止": 5.0,
          "段": "A",
          "画面": "剑横向右挥、墨点连成墨刃、墨刃涨满画面",
          "动作": "横挥"
        },
        {
          "起": 5.0,
          "止": 5.4,
          "段": "转",
          "画面": "整屏墨浪（12 帧）",
          "动作": "遮罩"
        },
        {
          "起": 5.4,
          "止": 6.8,
          "段": "B",
          "画面": "水墨雪原、银纹白袍+披风、剑已递出斜指画外",
          "动作": "递出"
        },
        {
          "起": 6.8,
          "止": 9.0,
          "段": "B",
          "画面": "定格、墨滴与雪粒散落",
          "动作": "定格"
        }
      ],
      "K": "A 段首帧（旧场景+旧装+按剑柄）",
      "M": "转场峰帧（整屏墨浪，边缘飞白）",
      "E": "B 段首帧（新场景+新装+剑斜指画外）",
      "适用": "同一角色两套装或两个场景；要变装、要时代切换时",
      "prompt要点": [
        "动作与运镜原样保留（来自动捕或参考片）",
        "元素必须三态贯穿",
        "转场两端姿势要对齐",
        "M 帧必须能盖满整屏"
      ],
      "难点": "两段生成 + 拼接，动作连续性只能靠 K/E 姿势对齐保证"
    }
  },
  "选择器": [
    {
      "条件": "人物最重要、兵器一般",
      "选": "A-凝视型"
    },
    {
      "条件": "兵器好看、能立起来",
      "选": "B-器物型"
    },
    {
      "条件": "兵器巨大、要成型",
      "选": "C-光效型"
    },
    {
      "条件": "要格局/片头定场",
      "选": "D-景观型"
    },
    {
      "条件": "要刷完播",
      "选": "E-循环型"
    },
    {
      "条件": "要变装 / 换场景 / 时代切换",
      "选": "F-变装型"
    }
  ]
}