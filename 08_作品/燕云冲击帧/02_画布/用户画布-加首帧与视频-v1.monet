   {
    "id": "node-04649b99",
    "type": "gen-image",
    "mainOutputId": null,
    "meta": {
     "x": 1700,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成】首帧·剑别在腰后（未出鞘·整体压暗）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版，黑白水墨武侠，电影静帧。\n【引用】{{node-050f0fc0}}＝脸；{{node-994a6484}}＝服装；{{node-79a92516}}＝武器外形。\n【人物】银白长发束起的青年剑客，白底黑纹长袍、黑内衬、黑腰封、护腕缠墨绳。\n【姿态·剑还在腰后（未出鞘）】侧身站在画面左侧三分之一，右肩朝镜头，重心压在后腿（不下蹲）；\n剑**斜插在右腰后、还没拔出来**——画面里只能看到**剑柄与一小截鞘口**露在右腰侧，\n**看不见剑身、更看不见剑尖**；右手**反手按在腰后的剑柄上**，手指扣住柄；\n左手垂在身侧、手指微张。脸微低、眼睛抬起看向镜头外。\n【明暗·这一帧要暗】整幅以暗为主：背景压成灰黑，人物半身没入暗部，\n只有脸部一小块纸白、剑柄上一道亮线；留白只在左上一小角。爆点留给下一帧。\n【背景】几道淡墨横扫、少量墨点；远景城楼剪影压到近黑。\n【题字】左上角竖排四字「霜寒九霄」，小字题款，一枚印章。\n负向：剑已拔出、剑身可见、剑尖朝前、剑举在身前、双手持剑、剑在头顶、\n大面积留白、整体发亮、彩色、冰蓝光效、发光、多只手、折腕、多余手指、\n除题字外的文字、水印、logo、游戏UI、卡通。\n",
      "size": "1K",
      "quality": "medium",
      "reference_images": [
       {
        "node_id": "node-050f0fc0"
       },
       {
        "node_id": "node-994a6484"
       },
       {
        "node_id": "node-79a92516"
       }
      ]
     }
    },
    "specialParams": null,
    "config": null,
    "createdAt": "2026-11-03T14:59:38.814+08:00",
