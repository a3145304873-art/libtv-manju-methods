    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版电影级首帧，只生成一张。\n【引用图片说明】{{node-d4a4f894}}＝人物（锁脸/白发/白袍黑带/冰霜气劲）；{{node-8f61092b}}＝武器（锁冰晶剑外形/龙形霜纹/护手虹彩）。\n【画面】中景全身，**起势**：人物侧身站定，剑**竖向举在身体右侧、挡住半张脸**，只露一只眼；\n双膝微屈、重心在右腿；剑尚未出招。白发与衣摆被右后方来风吹动，脚下有雪纹。\n【构图/机位】16:9 横版，平视略低；人物占画面高约 75%，站右三分；左侧三分之一是雪地留白与四五根旧木桩。\n【光影/材质】侧逆光，冷调；人物压成暗块，白发边缘与剑刃吃冷白边光；剑尖一点暖金。\n负向：已经在挥剑、出招、残影、多手多剑、全身远景过小、红、彩色光效、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-d4a4f894"
       },
       {
        "node_id": "node-8f61092b"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
