   {
    "id": "node-b5089354",
    "type": "input-text",
    "mainOutputId": "output-b5089354",
    "meta": {
     "x": 20,
     "y": 470,
     "width": 320,
     "height": 420,
     "label": "S1 角色与武器设定",
     "resourceType": null
    },
    "outputs": [
     {
      "id": "output-b5089354",
      "status": "done",
      "error": null,
      "value": "【角色与武器设定 · 只读】\n人物：年轻男性剑客，白发（长过胸、发尾散乱），白色宽袖长袍＋黑色内衬，黑色腰封与革带，\n手腕黑色护腕，深色靴；双臂缠绕淡薄的冰霜气劲；面部清瘦、眉压低、眼神冷静；本组不戴斗笠。\n武器：藏音·龙跃霄汉——冰晶长剑；剑身半透、内部龙形霜纹；护手一道极细虹彩（青→品红）；\n护手根部玉绿色晶簇；剑柄缠绳；剑尖明光偏暖（曜日）。\n\n【本画布用首尾帧】K＝起势（实色首帧），E＝结束姿势（实色尾帧），V 被两张图夹住——\n模型没有\"偷懒摆姿势\"的空间，必须把招式走完。I 直接从 E 改画，不再需要手工截帧。\n",
      "cover": null,
      "name": "S1 角色与武器设定",
      "resolution": null,
      "source": null,
      "batchId": null,
      "execution": null,
      "graphRunId": null,
      "iterationPath": null,
      "taskSource": null,
      "taskId": null,
