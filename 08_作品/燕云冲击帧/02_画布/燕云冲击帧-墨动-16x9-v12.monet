     "width": 320,
     "height": 280,
     "label": "【待生成】A0 设定母版（一张看完所有设定）",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版，**角色设定母版（一张看完所有设定）**，只生成一张。\n【引用图片说明】{{node-879b195a}}＝人物来源（锁脸/发型/服装/比例）；{{node-4b43bcd4}}＝武器来源（锁剑身/护手/剑柄）。\n【版式】三分栏，从左到右：\n  左栏：脸部正面特写（胸以上，占左栏高 80%）；\n  中栏：正面全身直立，手臂自然下垂、**手中不含武器**；\n  右栏：同一角色的 90° 侧面与背面并排（等高，各占右栏一半）；\n  上方留一条空白，**不要写任何文字或标注**。\n【一致性】四个视图必须是同一个人：同一张脸、同一发型长度、同一套服装、同一比例；不得换装、换脸、改比例。\n【风格/底】中性浅灰底（#B8B8B8 纯色，无渐变无纹理）；电影级写实；柔和顶侧光。\n负向：不同的脸、换装、换发型、动态姿势、持剑出招、武器、背景环境、UI、水印、文字、标注线、格子边框、卡通、夸张比例。\n",
      "reference_images": [
       {
        "node_id": "node-879b195a"
       },
       {
        "node_id": "node-4b43bcd4"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
    "specialParams": null,
    "config": null,
