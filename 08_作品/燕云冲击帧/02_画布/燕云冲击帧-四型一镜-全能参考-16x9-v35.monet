   {
    "id": "node-9f8d25e3",
    "type": "gen-video",
    "mainOutputId": null,
    "meta": {
     "x": 2820,
     "y": 20,
     "width": 320,
     "height": 280,
     "label": "【待生成·视频】① 4s 一镜：特写→后拉→白闪→墨凝",
     "resourceType": null
    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "seedance-2.0-mini",
     "model_params": {
      "prompt": "【首帧锁定】首帧使用 {{node-bfe85b06}}：暗底脸特写、只露一只眼，机位与光向不变。\n【尾帧锁定】最后一帧必须停在 {{node-1dbf8c68}}（水墨冲击帧）上，画面以它为准。\n【任务】4 秒连续一镜，**不许切镜**，按顺序完成四拍：\n0.0–1.0 秒 脸特写保持，眼里那点红光逐渐亮起来；\n1.0–1.8 秒 镜头**缓慢后拉**，露出中景：人物站立、剑垂在身侧、右手抬到胸前；\n1.8–2.0 秒 **白闪**（亮度只到纸白，不是纯白）；\n2.0–3.2 秒 墨从剑尖向四周涨开，十二帧内完成八成，人形从墨里**凝**出来；\n3.2–4.0 秒 水墨定格，只有墨滴落下。\n【水墨骤变】白闪时亮度只到**纸白（约九成白）不是纯白**；墨从剑尖向四周涨开、**十二帧内完成八成**；墨的边缘是毛的、带飞白；人形是从墨里**凝**出来的，不是淡入。\n【禁止】负向：切镜、变彩色、发光特效铺满、人物大动作、下蹲、文字、水印、logo、游戏UI、卡通。\n",
      "_reference_way": "frames",
      "reference_images": [
       {
        "node_id": "node-1dbf8c68"
       }
      ],
      "reference_videos": [],
      "reference_audios": [],
