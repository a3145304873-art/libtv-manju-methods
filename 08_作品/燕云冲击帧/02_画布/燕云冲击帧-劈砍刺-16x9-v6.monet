    },
    "outputs": [],
    "params": {
     "num": 1,
     "model_id": "gpt-image-2",
     "model_params": {
      "prompt": "16:9 横版电影级首帧，只生成一张。\n【引用图片说明】{{node-ae65a17f}}＝人物（锁脸/白发/白袍黑带/冰霜气劲）；{{node-0a38ce54}}＝武器（锁冰晶剑外形/龙形霜纹/护手虹彩）。\n【画面】中景全身，**起势·劈的准备**：双手握剑（右手主握、左手指节扣在柄尾），剑举过头顶右上方、剑尖朝后上；\n身体后倾、重心压在右腿，整个人蓄着往下砸的势；剑尚未劈出。雪原，风吹白发与衣摆。\n【构图/机位】16:9 横版，平视略低；人物占画面高约 75%，站右三分；左侧三分之一是雪地留白与四五根旧木桩。\n【光影/材质】侧逆光，冷调；人压成暗块，白发边缘与剑刃吃冷白边光；剑尖一点暖金。\n负向：已经劈下、剑在身前、残影、单手握剑、多手多剑、人物过小、红、彩色光效、文字、水印、logo、游戏UI、卡通。\n",
      "reference_images": [
       {
        "node_id": "node-ae65a17f"
       },
       {
        "node_id": "node-0a38ce54"
       }
      ],
      "aspect_ratio": "16:9",
      "image_size": "1K",
      "width": 1024,
      "height": 1024,
      "quality": "medium",
      "output_format": "png",
      "moderation": "low",
      "auto_compress": true
     }
    },
