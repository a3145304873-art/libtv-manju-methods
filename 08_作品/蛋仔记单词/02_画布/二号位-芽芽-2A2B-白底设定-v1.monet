          "label": "【待生成】2B 蛋形鸟体 · 毛绒设定图",
          "resourceType": null
        },
        "outputs": [],
        "params": {
          "num": 1,
          "model_id": "gpt-image-2",
          "model_params": {
            "prompt": "16:9 纯白底角色设定图，只生成一只“芽芽”，单个角色，正面偏 3/4 站姿，全身入画。\n参考图 {{node-aa051506}}、{{node-85c62672}} 只取形体：蛋形身体、头身一体、大头、大脸板、大眼睛、张嘴笑红舌无牙、短手短脚、白色小靴、头顶小球、柔光、纯白背景；材质改成毛茸茸的短毛绒/毛毡，哑光、纤维可见，不是光滑搪胶/塑料/3D 乙烯基；不要复制狗/猫帽、狗耳/猫耳、M 标志、具体配色。\n芽芽 2B：雾青绿（偏蓝的叶绿，不是草绿）毛绒蛋形身体，头身一体，没有脖子，头约占全身一半；13cm 玩具比例；没有连帽衫、没有帽子；\n奶油色大圆脸板，占正面大部分；脸板上是大圆眼：白眼球＋琥珀棕虹膜＋黑瞳孔＋一个白高光；毛绒玩偶的固定眼片/刺绣眼工艺，可眨眼；不是写实眼、不是光滑塑料反光；\n小三角毛毡喙，琥珀橘色，就是嘴，可开合说话；无牙、无舌、不出现口腔内部；脸板上没有第二张嘴；\n头顶一株毛毡卷叶芽，芽尖一颗小琥珀球；身后一片大叶形毛毡尾羽，深青绿，中央浅色缝线叶脉；\n两只短圆毛绒手臂，雾青绿，末端奶油白毛毡手套，无手指；两条短腿，白袜＋白色毛毡小靴，靴口雾青绿边，无脚趾；\n胸口一枚毛毡/刺绣小叶子徽章（金色/奶油色），不要 M 标志；\n短毛绒/毛毡质感，毛茸茸、哑光、纤维可见，边缘有细绒光；不是光滑搪胶、不是塑料、不是 3D 乙烯基、不是写实鸟；\n纯白背景，无阴影地面，无第二只角色，无文字、无字幕、无 logo、无水印。\n负向：连帽、帽子、帽上喙、两张嘴、狗帽、猫帽、狗耳、猫耳、狗嘴、猫脸、M 标志、参考图角色、第二只角色、心易、水豚、橘子、写实鸟、真实羽毛、鸟爪、长脖子、长腿、手指、脚趾、多余手臂、第三只手、多双手、两只以上的脚、牙齿、舌头、张开的口腔内部、心易的白片无瞳、深棕大眼圈、文字、字幕、logo、水印、光滑搪胶、塑料高光、3D 乙烯基、vinyl、写实眼、过曝、比例失真、灰底、渐变底、地面阴影、场景、道具。",
            "reference_images": [
              {
                "node_id": "node-aa051506"
              },
              {
                "node_id": "node-85c62672"
              }
            ],
            "aspect_ratio": "16:9",
            "image_size": "1K",
            "width": 1024,
            "height": 1024,
            "quality": "medium",
            "output_format": "png",
            "moderation": "low",
            "auto_compress": true
          }
        },
        "specialParams": null,
        "config": null,
        "createdAt": "2026-11-04T11:21:52.496+08:00",
