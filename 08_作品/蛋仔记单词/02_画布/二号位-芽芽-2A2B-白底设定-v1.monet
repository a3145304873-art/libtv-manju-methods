      {
        "id": "node-3e3e1e10",
        "type": "gen-image",
        "mainOutputId": null,
        "meta": {
          "x": 400.0,
          "y": 0.0,
          "width": 340.0,
          "height": 224.0,
          "label": "【待生成】2A 叶鸟连帽 · 毛绒设定图",
          "resourceType": null
        },
        "outputs": [],
        "params": {
          "num": 1,
          "model_id": "gpt-image-2",
          "model_params": {
            "prompt": "16:9 纯白底角色设定图，只生成一只“芽芽”，单个角色，正面偏 3/4 站姿，全身入画。\n参考图 {{node-aa051506}}、{{node-85c62672}} 只取形体：蛋形身体、头身一体、大头、大脸板、大眼睛、张嘴笑红舌无牙、短手短脚、白色小靴、头顶小球、柔光、纯白背景；材质改成毛茸茸的短毛绒/毛毡，哑光、纤维可见，不是光滑搪胶/塑料/3D 乙烯基；不要复制狗/猫帽、狗耳/猫耳、M 标志、具体配色。\n芽芽 2A：奶油白/米白毛绒蛋形身体，头身一体，没有脖子，头约占全身一半；13cm 玩具比例；\n穿雾青绿毛毡叶子鸟连帽衫：帽子覆盖头顶和后脑，帽前额一个小三角琥珀喙（闭合，装饰，不是说话嘴），帽顶一株卷叶芽、芽尖一颗小琥珀球；帽后下方一片大叶形尾羽，深青绿，中央浅色缝线叶脉；\n奶油色大圆脸板，占正面大部分，边缘一圈浅绿细边；\n大圆眼：白眼球＋琥珀棕虹膜＋黑瞳孔＋一个白高光；毛绒玩偶的固定眼片/刺绣眼工艺，可眨眼、可做表情；不是写实眼、不是光滑塑料反光；\n张嘴笑，红色舌头，无牙；说话时用脸板的嘴开合，帽子上的喙不动；\n两只短圆毛绒手臂，奶油白，末端雾青绿毛毡手套，无手指；两条短腿，白袜＋白色毛毡小靴，靴口雾青绿边，无脚趾；\n胸口一枚毛毡/刺绣小叶子徽章（金色/奶油色），不要 M 标志；\n短毛绒/毛毡质感，毛茸茸、哑光、纤维可见，边缘有细绒光；不是光滑搪胶、不是塑料、不是 3D 乙烯基、不是写实鸟；\n纯白背景，无阴影地面，无第二只角色，无文字、无字幕、无 logo、无水印。\n负向：狗帽、猫帽、狗耳、猫耳、狗嘴、猫脸、M 标志、参考图角色、第二只角色、心易、水豚、橘子、写实鸟、真实羽毛、鸟爪、长脖子、长腿、手指、脚趾、多余手臂、第三只手、多双手、两只以上的脚、牙齿、写实舌头、心易的白片无瞳、深棕大眼圈、文字、字幕、logo、水印、光滑搪胶、塑料高光、3D 乙烯基、vinyl、写实眼、过曝、比例失真、灰底、渐变底、地面阴影、场景、道具。",
            "reference_images": [
              {
                "node_id": "node-aa051506"
              },
              {
                "node_id": "node-85c62672"
              }
            ],
            "aspect_ratio": "16:9",
            "image_size": "1K",
            "width": 1024,
            "height": 1024,
            "quality": "medium",
            "output_format": "png",
            "moderation": "low",
            "auto_compress": true
          }
