          "height": 170.0,
          "label": "【待生成】R01P 黄蛋毛绒版 · 同水豚短毛绒质感",
          "resourceType": null
        },
        "outputs": [],
        "params": {
          "num": 1,
          "model_id": "gpt-image-2",
          "model_params": {
            "prompt": "16:9 纯白底角色设定图，只生成一只黄蛋（毛绒版），全身正面。\n保留黄蛋身份：黄色蛋形身体、奶油色椭圆大脸板、棕色大圆眼、头顶黄色天线+黄色圆球、短圆手臂无手指、白色袜子（黑条纹）+白色毛绒靴；没有牙齿。\n材质改成和参考水豚玩偶一致的短毛绒/毛毡玩偶质感：表面细短绒毛、可见纤维、柔和缝线、哑光；脸板是奶油色毛毡/布；眼睛是亮面塑料/刺绣；天线球是布球；袜子/鞋是白布；边缘有轻微绒毛轮廓；柔光棚拍，轻微投影。\n不要：光滑塑料/搪胶、真实鸡蛋、蛋壳裂开、蛋黄/蛋液、牙齿、人类手指、猫耳/水豚耳朵、橘子、文字/logo/水印。\n负向：光滑塑料、真实照片、人类、手指、牙齿、裂壳、蛋液、蛋黄、文字、logo、水印、比例失真。",
            "reference_images": [
              {
                "node_id": "node-112f8dd1"
              }
            ],
            "aspect_ratio": "16:9",
            "image_size": "1K",
            "width": 1024,
            "height": 1024,
            "quality": "medium",
            "output_format": "png",
            "moderation": "low",
            "auto_compress": true
          }
        },
