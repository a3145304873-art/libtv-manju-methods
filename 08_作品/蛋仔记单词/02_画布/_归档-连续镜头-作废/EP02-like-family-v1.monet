      {
        "id": "node-68bd4e09",
        "type": "gen-video",
        "mainOutputId": null,
        "meta": {
          "x": 1650.0,
          "y": 310.0,
          "width": 360.0,
          "height": 240.0,
          "label": "【待生成】Part B · 15–30s · childlike＋四栏卡＋合影",
