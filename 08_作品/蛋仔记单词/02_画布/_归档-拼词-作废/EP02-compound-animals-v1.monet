          "height": 207.0,
          "label": "【待生成】A01 四只合成动物设定（热狗狗/树篱猪/海马/猫鱼）· 1K",
          "resourceType": null
        },
        "outputs": [],
        "params": {
          "num": 1,
          "model_id": "gpt-image-2",
          "model_params": {
            "prompt": "16:9 纯白底角色设定图，只生成并排一排四只合成动物，同一比例（每只约为 12cm 蛋仔身高的 1–1.3 倍），完整入画：\n①热狗狗：奶黄色小狗，吐舌、尾巴摇，头顶冒白色热气；\n②树篱猪：粉色小猪，身体一半从圆形绿色树篱里钻出，树篱带叶子；\n③海马：小马，棕白毛色，戴小潜水镜，后半身是鱼尾；\n④猫鱼：灰蓝色鱼，嘴边有猫胡须，头顶一对小猫耳。\n3D 卡通渲染+真实光影（皮克斯质感、搪胶材质、次表面散射），轻微高光。\n背景 #FFFFFF 纯白，无投影、无文字、无水印、无 logo。\n负向：真实照片、恐怖、尖牙利爪、人类、手指、文字、水印、logo、比例失真、多余动物。",
            "reference_images": [],
            "aspect_ratio": "16:9",
