          "width": 300.0,
          "height": 197.0,
          "label": "【待生成】K_A 首帧 · 石桌 · rocklike / 是什么意思？",
          "resourceType": null
        },
        "outputs": [],
        "params": {
          "num": 1,
          "model_id": "gpt-image-2",
          "model_params": {
            "prompt": "16:9 电影感首帧，第0秒，只生成一张。小院石桌角（参考 {{node-d67c8efd}}）：双人中景，心易（参考 {{node-34b2e592}}，棕色水豚/卡皮巴拉毛绒玩偶）在画面左1/3，站在石桌旁，头顶橘子；她头右上浮一个白色3D对话气泡（参考 {{node-fff5f063}}），气泡里两行黑字：第一行“rocklike”，第二行“是什么意思？”；文字必须和 {{node-fff5f063}} 完全一致，不要改字/加字/变成问号。心易嘴巴闭合、不说话、表情淡定。黄蛋（参考 {{node-1dec7c6e}}，外形/比例参考 {{node-3b85595e}}）在画面右1/3，看向心易/气泡。低机位，午后暖光，3D卡通+真实光影（皮克斯/搪胶）。\n无其他文字/字幕/logo。\n负向：旧心易/粉蛋/猫耳/天线、角色说话、多个气泡、文字错误、乱码、字幕、logo、人类、比例失真、过曝。",
            "reference_images": [
              {
                "node_id": "node-3b85595e"
