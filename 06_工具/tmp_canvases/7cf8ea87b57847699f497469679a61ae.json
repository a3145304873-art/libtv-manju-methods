e", "position": {"positionX": "180", "positionY": "-72"}, "measured": {"width": "350", "height": "525"}, "data": "{\"type\":\"image\",\"url\":[\"https://libtv-res.liblib.art/upload-images/c877ae5f261e41f5ae729cbe749e60e8/d11aceaea4d943a94c4bf9e084099a8cc4ad2a01.png\"],\"action\":\"image_resource\",\"resourceMeta\":{\"items\":[{\"kind\":\"image\",\"mimeType\":\"image/png\",\"byteSize\":329947,\"extension\":\"png\"}]},\"name\":\"image\",\"generatorType\":\"default\",\"uploaded\":true,\"_explicitContentDims\":true,\"contentWidth\":350,\"contentHeight\":525,\"_resourceMeta\":{\"items\":[{\"kind\":\"image\",\"mimeType\":\"image/png\",\"byteSize\":329947,\"extension\":\"png\",\"width\":400,\"height\":600,\"hashSha1\":\"d11aceaea4d943a94c4bf9e084099a8cc4ad2a01\"}]}}", "parentKey": "", "status": 1, "createdAtMs": 1793792549000, "updatedAtMs": 1793792585000, "workflowUuid": "", "workflowRoot": 0}, {"nodeKey": "i-ZGv7tJ06Q6", "projectUuid": "7cf8ea87b57847699f497469679a61ae", "toolId": 0, "toolKey": "", "type": 2, "name": "image", "position": {"positionX": "192", "positionY": "936"}, "measured": {"width": "416", "height": "350"}, "data": "{\"type\":\"image\",\"url\":[\"https://libtv-res.liblib.art/upload-images/c877ae5f261e41f5ae729cbe749e60e8/bb14f04ed2896a9cc631df2109914ae5e135df23.png\"],\"action\":\"image_resource\",\"resourceMeta\":{\"items\":[{\"kind\":\"image\",\"mimeType\":\"image/png\",\"byteSize\":106486,\"extension\":\"png\"}]},\"name\":\"image\",\"generatorType\":\"default\",\"uploaded\":true,\"_explicitContentDims\":true,\"contentWidth\":416,\"contentHeight\":350,\"_resourceMeta\":{\"items\":[{\"kind\":\"image\",\"mimeType\":\"image/png\",\"byteSize\":106486,\"extension\":\"png\",\"width\":512,\"height\":431,\"hashSha1\":\"bb14f04ed2896a9cc631df2109914ae5e135df23\"}]}}", "parentKey": "", "status": 1, "createdAtMs": 1793792614000, "updatedAtMs": 1793792697000, "workflowUuid": "", "workflowRoot": 0}, {"nodeKey": "t-LE6KVrBcBt", "projectUuid": "7cf8ea87b57847699f497469679a61ae", "toolId": 0, "toolKey": "", "type": 1, "name": "文本", "position": {"positionX": "1145", "positionY": "509"}, "measured": {"width": "350", "height": "200"}, "data": "{\"type\":\"text\",\"name\":\"文本\",\"content\":[\"目标是「玩梗学单词」：用自然谐音、词形/词族联想或语义场景，把英文词和准确词义连起来，让观众在笑点里记住。\\n\\n不做课堂讲解；词典、音标、义项核对是防错底线。\\n\\n谐音不再是唯一默认方法；每个词要比较至少两条记忆路径，说明它怎样把词形/读音连到准确词义（english-story schema 3 的 joke_design）。\\n\\n谐音只做记忆钩子，不冒充标准发音或词源；音形不支持就不硬造。\"],\"action\":\"text_resource\"}", "parentKey": "", "status": 1, "createdAtMs": 1793793179000, "updatedAtMs": 1793793670000, "workflowUuid": "", "workflowRoot": 0}], "connectionList": null}, "msg": "", "trace_id": "29dded95-e5cf-9357-a984-8b1d26fbf02a"}